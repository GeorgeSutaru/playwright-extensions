{
  "name": "@playwright-extensions/reporter-server",
  "version": "0.0.1",
  "description": "Dashboard server for extended-playwright-reporter",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "reporter-server": "./bin/reporter-server.js"
  },
  "scripts": {
    "build": "tsc && rm -rf dist/views dist/static && cp -r src/views dist/views && cp -r src/static dist/static",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/multipart": "^9.0.1",
    "@fastify/static": "^8.0.4",
    "@fastify/view": "^11.0.0",
    "diff": "^7.0.0",
    "drizzle-orm": "^0.39.3",
    "ejs": "^3.1.10",
    "fastify": "^5.2.1",
    "pg": "^8.13.1",
    "postgres": "^3.4.9",
    "unzipper": "^0.12.3"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/diff": "^6.0.0",
    "@types/ejs": "^3.1.5",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/unzipper": "^0.10.10",
    "archiver": "^7.0.1",
    "drizzle-kit": "^0.30.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "files": [
    "dist",
    "bin",
    "scripts"
  ]
}

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'Reporter Dashboard' %></title>
  <link rel="stylesheet" href="/static/styles.css">
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
</head>
<body>
  <nav class="sidebar">
    <div class="logo">
      <h1>Reporter</h1>
    </div>
    <ul class="nav-links">
      <li><a href="/" class="<%= currentView === 'dashboard' ? 'active' : '' %>">Dashboard</a></li>
      <li><a href="/runs" class="<%= currentView === 'runs' ? 'active' : '' %>">Runs</a></li>
      <li><a href="/trends" class="<%= currentView === 'trends' ? 'active' : '' %>">Trends</a></li>
      <li><a href="/search" class="<%= currentView === 'search' ? 'active' : '' %>">Search Traces</a></li>
    </ul>
  </nav>
  <main class="content">
    <div class="page-header">
      <a href="/runs" class="back-link">&larr; Back to Runs</a>
      <h2>Run Detail</h2>
    </div>

    <div id="runDetail">
      <div class="run-meta" id="runMeta"></div>

      <div class="filters">
        <input type="text" id="searchTests" placeholder="Search tests..." class="search-input">
        <select id="filterTestStatus" class="filter-select">
          <option value="">All</option>
          <option value="passed">Passed</option>
          <option value="failed">Failed</option>
          <option value="skipped">Skipped</option>
          <option value="flaky">Flaky</option>
        </select>
      </div>

      <table class="data-table">
        <thead>
          <tr>
            <th>Test</th>
            <th>File</th>
            <th>Status</th>
            <th>Duration</th>
            <th>Retry</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody id="testsBody">
          <tr><td colspan="6" class="empty-state">Loading...</td></tr>
        </tbody>
      </table>
    </div>
  </main>
  <script src="/static/app.js"></script>
  <script>
    window.API_BASE = '/api/v1';
    window.RUN_ID = '<%= runId %>';
  </script>
</body>
</html>

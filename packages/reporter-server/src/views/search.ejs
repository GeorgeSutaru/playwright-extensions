<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'Reporter Dashboard' %></title>
  <link rel="stylesheet" href="/static/styles.css">
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
</head>
<body>
  <nav class="sidebar">
    <div class="logo">
      <h1>Reporter</h1>
    </div>
    <ul class="nav-links">
      <li><a href="/" class="<%= currentView === 'dashboard' ? 'active' : '' %>">Dashboard</a></li>
      <li><a href="/runs" class="<%= currentView === 'runs' ? 'active' : '' %>">Runs</a></li>
      <li><a href="/trends" class="<%= currentView === 'trends' ? 'active' : '' %>">Trends</a></li>
      <li><a href="/search" class="<%= currentView === 'search' ? 'active' : '' %>">Search Traces</a></li>
    </ul>
  </nav>
  <main class="content">
    <div class="page-header">
      <h2>Search Traces</h2>
    </div>

    <div class="filters">
      <input type="text" id="searchQuery" placeholder="Search actions, selectors, errors, URLs..." class="search-input" style="flex:1;">
      <input type="text" id="searchActionType" placeholder="Action type (click, fill, goto...)" class="filter-input">
      <button onclick="searchTraces()" class="btn btn-primary">Search</button>
    </div>

    <div class="section">
      <table class="data-table">
        <thead>
          <tr>
            <th>Action</th>
            <th>Selector</th>
            <th>URL</th>
            <th>Duration</th>
            <th>Error</th>
            <th>Fingerprint</th>
          </tr>
        </thead>
        <tbody id="searchResults">
          <tr><td colspan="7" class="empty-state">Enter a search query above</td></tr>
        </tbody>
      </table>
    </div>
  </main>
  <script src="/static/app.js"></script>
  <script>
    window.API_BASE = '/api/v1';
  </script>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'Reporter Dashboard' %></title>
  <link rel="stylesheet" href="/static/styles.css">
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
</head>
<body>
  <nav class="sidebar">
    <div class="logo">
      <h1>Reporter</h1>
    </div>
    <ul class="nav-links">
      <li><a href="/" class="<%= currentView === 'dashboard' ? 'active' : '' %>">Dashboard</a></li>
      <li><a href="/runs" class="<%= currentView === 'runs' ? 'active' : '' %>">Runs</a></li>
      <li><a href="/trends" class="<%= currentView === 'trends' ? 'active' : '' %>">Trends</a></li>
    </ul>
  </nav>
  <main class="content">
    <div class="page-header">
      <h2>Test Runs</h2>
    </div>

    <div class="filters">
      <input type="text" id="searchRuns" placeholder="Search runs..." class="search-input">
      <select id="filterStatus" class="filter-select">
        <option value="">All Status</option>
        <option value="passed">Passed</option>
        <option value="failed">Failed</option>
      </select>
      <input type="date" id="filterFrom" class="filter-input">
      <input type="date" id="filterTo" class="filter-input">
      <button onclick="loadRuns()" class="btn btn-primary">Apply</button>
    </div>

    <div id="runsTable" class="section">
      <table class="data-table">
        <thead>
          <tr>
            <th>Run</th>
            <th>Project</th>
            <th>Tests</th>
            <th>Passed</th>
            <th>Failed</th>
            <th>Flaky</th>
            <th>Skipped</th>
            <th>Started</th>
            <th>Source</th>
          </tr>
        </thead>
        <tbody id="runsBody">
          <tr><td colspan="9" class="empty-state">Loading...</td></tr>
        </tbody>
      </table>
      <div class="pagination" id="runsPagination"></div>
    </div>
  </main>
  <script src="/static/app.js"></script>
  <script>
    window.API_BASE = '/api/v1';
  </script>
</body>
</html>

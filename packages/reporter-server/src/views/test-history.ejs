<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'Reporter Dashboard' %></title>
  <link rel="stylesheet" href="/static/styles.css">
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
</head>
<body>
  <nav class="sidebar">
    <div class="logo">
      <h1>Reporter</h1>
    </div>
    <ul class="nav-links">
      <li><a href="/" class="<%= currentView === 'dashboard' ? 'active' : '' %>">Dashboard</a></li>
      <li><a href="/runs" class="<%= currentView === 'runs' ? 'active' : '' %>">Runs</a></li>
      <li><a href="/trends" class="<%= currentView === 'trends' ? 'active' : '' %>">Trends</a></li>
    </ul>
  </nav>
  <main class="content">
    <div class="page-header">
      <a href="/runs/<%= runId %>" class="back-link">&larr; Back to Run</a>
      <h2>Test History</h2>
    </div>

    <div class="test-info" id="testInfo"></div>

    <div class="section">
      <h3>Execution History</h3>
      <table class="data-table">
        <thead>
          <tr>
            <th>Run</th>
            <th>Status</th>
            <th>Duration</th>
            <th>Retry</th>
            <th>Error</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody id="historyBody">
          <tr><td colspan="6" class="empty-state">Loading...</td></tr>
        </tbody>
      </table>
    </div>

    <div class="section" id="diffSection" style="display:none;">
      <h3>Snapshot Diff</h3>
      <div class="diff-controls">
        <select id="diffFingerprint"></select>
        <select id="diffSnapshotType">
          <option value="before">Before</option>
          <option value="after" selected>After</option>
        </select>
        <button onclick="loadDiff()" class="btn btn-primary">Compare</button>
      </div>
      <div class="diff-viewer" id="diffViewer"></div>
    </div>
  </main>
  <script src="/static/app.js"></script>
  <script>
    window.API_BASE = '/api/v1';
    window.TEST_ID = '<%= testId %>';
    window.RUN_ID = '<%= runId %>';
  </script>
</body>
</html>

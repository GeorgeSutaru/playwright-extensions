<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'Reporter Dashboard' %></title>
  <link rel="stylesheet" href="/static/styles.css">
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
</head>
<body>
  <nav class="sidebar">
    <div class="logo">
      <h1>Reporter</h1>
    </div>
    <ul class="nav-links">
      <li><a href="/" class="<%= currentView === 'dashboard' ? 'active' : '' %>">Dashboard</a></li>
      <li><a href="/runs" class="<%= currentView === 'runs' ? 'active' : '' %>">Runs</a></li>
      <li><a href="/trends" class="<%= currentView === 'trends' ? 'active' : '' %>">Trends</a></li>
      <li><a href="/search" class="<%= currentView === 'search' ? 'active' : '' %>">Search Traces</a></li>
    </ul>
  </nav>
  <main class="content">
    <div class="page-header">
      <a href="/search" class="back-link">&larr; Back to Search</a>
      <h2>Snapshot Diff</h2>
    </div>

    <div class="diff-config">
      <div class="form-group">
        <label>Fingerprint</label>
        <input type="text" id="diffFingerprint" placeholder="Action fingerprint" class="form-input">
      </div>
      <div class="form-row">
        <div class="form-group">
          <label>Run A (baseline)</label>
          <input type="text" id="diffRunA" placeholder="Run ID" class="form-input">
        </div>
        <div class="form-group">
          <label>Run B (comparison)</label>
          <input type="text" id="diffRunB" placeholder="Run ID" class="form-input">
        </div>
      </div>
      <div class="form-group">
        <label>Snapshot Type</label>
        <select id="diffSnapshotType" class="form-input">
          <option value="before">Before</option>
          <option value="after" selected>After</option>
        </select>
      </div>
      <button onclick="loadDiff()" class="btn btn-primary">Compare Snapshots</button>
    </div>

    <div class="diff-result" id="diffResult" style="display:none;">
      <div class="diff-meta" id="diffMeta"></div>
      <div class="diff-panels">
        <div class="diff-panel">
          <h4>Run A (Baseline)</h4>
          <div class="snapshot-frame" id="snapshotA"></div>
        </div>
        <div class="diff-panel">
          <h4>Run B (Comparison)</h4>
          <div class="snapshot-frame" id="snapshotB"></div>
        </div>
      </div>
      <div class="diff-text" id="diffText"></div>
    </div>
  </main>
  <script src="/static/app.js"></script>
  <script>
    window.API_BASE = '/api/v1';
  </script>
</body>
</html>

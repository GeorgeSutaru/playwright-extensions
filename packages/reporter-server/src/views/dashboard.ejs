<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'Reporter Dashboard' %></title>
  <link rel="stylesheet" href="/static/styles.css">
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
</head>
<body>
  <nav class="sidebar">
    <div class="logo">
      <h1>Reporter</h1>
    </div>
    <ul class="nav-links">
      <li><a href="/" class="<%= currentView === 'dashboard' ? 'active' : '' %>">Dashboard</a></li>
      <li><a href="/runs" class="<%= currentView === 'runs' ? 'active' : '' %>">Runs</a></li>
      <li><a href="/trends" class="<%= currentView === 'trends' ? 'active' : '' %>">Trends</a></li>
    </ul>
  </nav>
  <main class="content">
    <div class="page-header">
      <h2>Dashboard</h2>
    </div>

    <div class="stats-grid">
      <div class="stat-card">
        <div class="stat-value"><%= stats.totalRuns || 0 %></div>
        <div class="stat-label">Total Runs</div>
      </div>
      <div class="stat-card">
        <div class="stat-value"><%= stats.totalTests || 0 %></div>
        <div class="stat-label">Total Tests</div>
      </div>
      <div class="stat-card">
        <div class="stat-value stat-pass"><%= stats.passRate || 0 %>%</div>
        <div class="stat-label">Pass Rate</div>
      </div>
      <div class="stat-card">
        <div class="stat-value stat-fail"><%= stats.totalFailed || 0 %></div>
        <div class="stat-label">Total Failures</div>
      </div>
    </div>

    <div class="charts-row">
      <div class="chart-container">
        <h3>Pass Rate Trend</h3>
        <canvas id="passRateChart"></canvas>
      </div>
      <div class="chart-container">
        <h3>Recent Runs</h3>
        <canvas id="recentRunsChart"></canvas>
      </div>
    </div>

    <div class="section">
      <h3>Recent Runs</h3>
      <table class="data-table">
        <thead>
          <tr>
            <th>Run</th>
            <th>Project</th>
            <th>Status</th>
            <th>Duration</th>
            <th>Started</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (!runs || runs.length === 0) { %>
            <tr><td colspan="6" class="empty-state">No runs yet. Run your tests with the extended reporter.</td></tr>
          <% } else { %>
            <% runs.forEach(function(run) { %>
              <tr data-run-id="<%= run.id %>">
                <td><a href="/runs/<%= run.id %>"><%= run.title || 'Untitled Run' %></a></td>
                <td><%= run.project || '-' %></td>
                <td><span class="badge <%= run.failed > 0 ? 'badge-fail' : 'badge-pass' %>"><%= run.passed %>/<%= run.totalTests %></span></td>
                <td><%= formatDuration(run.endedAt, run.startedAt) %></td>
                <td><%= formatDate(run.startedAt) %></td>
                <td><button class="btn btn-small btn-fail delete-run-btn" onclick="deleteRun('<%= run.id %>')">Delete</button></td>
              </tr>
            <% }); %>
          <% } %>
        </tbody>
      </table>
    </div>
  </main>
  <script src="/static/app.js"></script>
  <script>
    window.API_BASE = '/api/v1';
  </script>
</body>
</html>

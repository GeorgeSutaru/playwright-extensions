<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'Reporter Dashboard' %></title>
  <link rel="stylesheet" href="/static/styles.css">
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
</head>
<body>
  <nav class="sidebar">
    <div class="logo">
      <h1>Reporter</h1>
    </div>
    <ul class="nav-links">
      <li><a href="/" class="<%= currentView === 'dashboard' ? 'active' : '' %>">Dashboard</a></li>
      <li><a href="/runs" class="<%= currentView === 'runs' ? 'active' : '' %>">Runs</a></li>
      <li><a href="/trends" class="<%= currentView === 'trends' ? 'active' : '' %>">Trends</a></li>
      <li><a href="/search" class="<%= currentView === 'search' ? 'active' : '' %>">Search Traces</a></li>
    </ul>
  </nav>
  <main class="content">
    <div class="page-header">
      <h2>Trends</h2>
    </div>

    <div class="filters">
      <input type="date" id="trendFrom" class="filter-input">
      <input type="date" id="trendTo" class="filter-input">
      <select id="trendGroupBy" class="filter-select">
        <option value="day">By Day</option>
        <option value="run">By Run</option>
      </select>
      <button onclick="loadTrends()" class="btn btn-primary">Apply</button>
    </div>

    <div class="charts-row">
      <div class="chart-container full-width">
        <h3>Pass Rate Over Time</h3>
        <canvas id="trendChart"></canvas>
      </div>
    </div>

    <div class="charts-row">
      <div class="chart-container">
        <h3>Test Results Distribution</h3>
        <canvas id="distributionChart"></canvas>
      </div>
      <div class="chart-container">
        <h3>Recurring Failures</h3>
        <table class="data-table" id="recurringFailures">
          <thead>
            <tr>
              <th>Test</th>
              <th>File</th>
              <th>Failures</th>
              <th>Last Error</th>
            </tr>
          </thead>
          <tbody>
            <tr><td colspan="4" class="empty-state">Loading...</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </main>
  <script src="/static/app.js"></script>
  <script>
    window.API_BASE = '/api/v1';
  </script>
</body>
</html>

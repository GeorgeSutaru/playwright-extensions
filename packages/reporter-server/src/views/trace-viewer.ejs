<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'Reporter Dashboard' %></title>
  <link rel="stylesheet" href="/static/styles.css">
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
</head>
<body>
  <nav class="sidebar">
    <div class="logo">
      <h1>Reporter</h1>
    </div>
    <ul class="nav-links">
      <li><a href="/" class="<%= currentView === 'dashboard' ? 'active' : '' %>">Dashboard</a></li>
      <li><a href="/runs" class="<%= currentView === 'runs' ? 'active' : '' %>">Runs</a></li>
      <li><a href="/trends" class="<%= currentView === 'trends' ? 'active' : '' %>">Trends</a></li>
      <li><a href="/search" class="<%= currentView === 'search' ? 'active' : '' %>">Search Traces</a></li>
    </ul>
  </nav>
  <main class="content">
    <div class="page-header">
      <a href="/runs/<%= runId %>" class="back-link">&larr; Back to Run</a>
      <h2>Trace Viewer</h2>
    </div>

    <div class="section">
      <h3>Actions Timeline</h3>
      <div id="traceTimeline" class="trace-timeline">
        <p class="empty-state">Loading trace entries...</p>
      </div>
    </div>

    <div class="section" id="snapshotSection" style="display:none;">
      <h3>Snapshot</h3>
      <div class="snapshot-tabs">
        <button class="tab-btn active" onclick="showSnapshot('before')">Before</button>
        <button class="tab-btn" onclick="showSnapshot('after')">After</button>
      </div>
      <div class="snapshot-viewer" id="snapshotViewer"></div>
    </div>
  </main>
  <script src="/static/app.js"></script>
  <script>
    window.API_BASE = '/api/v1';
    window.TEST_ID = '<%= testId %>';
    window.RUN_ID = '<%= runId %>';
  </script>
</body>
</html>
